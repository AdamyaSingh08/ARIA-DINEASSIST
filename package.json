{
  "name": "dineassist",
  "version": "1.0.0",
  "description": "DineAssist — A Smart Restaurant Robot Management Dashboard for INNOTech Hackathon",
  "scripts": {
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,magenta\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "seed": "npm --prefix backend run seed",
    "test:robot": "node scripts/test_robot_event.js"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
